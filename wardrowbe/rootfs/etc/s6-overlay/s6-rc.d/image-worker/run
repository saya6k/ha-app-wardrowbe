#!/usr/bin/with-contenv bash
# shellcheck shell=bash
set -euo pipefail

# Backend startup initializes the database and runs Alembic migrations.
echo "[image-worker] waiting for backend …"
ready=false
for _ in $(seq 1 90); do
  if curl -fsS "http://127.0.0.1:${BACKEND_PORT}/api/v1/health" >/dev/null 2>&1; then
    ready=true
    break
  fi
  sleep 1
done
if [[ "${ready}" != true ]]; then
  echo "[image-worker] backend did not become healthy; retrying via s6" >&2
  exit 1
fi

cd /app/backend
echo "[image-worker] starting arq image worker …"
exec /opt/venv/bin/arq app.workers.image_worker.ImageWorkerSettings
