#!/usr/bin/with-contenv bash
# shellcheck shell=bash
set -euo pipefail

# ── Wait for PostgreSQL ───────────────────────────────────────────────────
echo "[backend] waiting for postgres …"
for _ in $(seq 1 60); do
  if pg_isready -h 127.0.0.1 -p "${POSTGRES_PORT}" -q 2>/dev/null; then
    break
  fi
  sleep 1
done

# ── Rename legacy role + database (one-time) ──────────────────────────────
# ≤ 4.3.x took user/db names from options (default "wardrobe"); they are now
# fixed. The cluster holds only this app's database, so the single
# non-system one is the legacy database, whatever it was called. Renaming
# it and its owner keeps ownership of every object, so no data moves.
psql -U postgres -p "${POSTGRES_PORT}" -v ON_ERROR_STOP=1 <<SQL
DO \$\$
DECLARE
  legacy_db   name;
  legacy_role name;
  candidates  int;
BEGIN
  IF EXISTS (SELECT FROM pg_database WHERE datname = '${POSTGRES_DB}') THEN
    RETURN;
  END IF;
  SELECT count(*), min(d.datname), min(r.rolname)
    INTO candidates, legacy_db, legacy_role
    FROM pg_database d JOIN pg_roles r ON r.oid = d.datdba
   WHERE NOT d.datistemplate AND d.datname <> 'postgres';
  IF candidates = 0 THEN
    RETURN;
  ELSIF candidates > 1 THEN
    RAISE WARNING 'several legacy databases found; not migrating any';
    RETURN;
  END IF;

  RAISE NOTICE 'migrating database % (owner %) to ${POSTGRES_DB}', legacy_db, legacy_role;
  IF legacy_role <> 'postgres'
     AND NOT EXISTS (SELECT FROM pg_roles WHERE rolname = '${POSTGRES_USER}') THEN
    EXECUTE format('ALTER ROLE %I RENAME TO ${POSTGRES_USER}', legacy_role);
  END IF;
  PERFORM pg_terminate_backend(pid, 5000)
     FROM pg_stat_activity WHERE datname = legacy_db;
  EXECUTE format('ALTER DATABASE %I RENAME TO ${POSTGRES_DB}', legacy_db);
END
\$\$;
SQL

# ── Create role + database (idempotent) ───────────────────────────────────
# CREATE ROLE does not support IF NOT EXISTS, so we check in PL/pgSQL.
# The password is reset every start (a role rename also clears it).
echo "[backend] ensuring database and role exist …"
psql -U postgres -p "${POSTGRES_PORT}" <<SQL
DO \$\$
BEGIN
  IF NOT EXISTS (SELECT FROM pg_roles WHERE rolname = '${POSTGRES_USER}') THEN
    CREATE ROLE ${POSTGRES_USER} WITH LOGIN;
  END IF;
END
\$\$;
ALTER ROLE ${POSTGRES_USER} WITH LOGIN PASSWORD '${POSTGRES_PASSWORD}';
SQL

psql -U postgres -p "${POSTGRES_PORT}" <<SQL
SELECT 'CREATE DATABASE ${POSTGRES_DB} OWNER ${POSTGRES_USER};'
WHERE NOT EXISTS (SELECT FROM pg_database WHERE datname = '${POSTGRES_DB}')
\gexec
SQL

# ── Wait for Redis ────────────────────────────────────────────────────────
echo "[backend] waiting for redis …"
for _ in $(seq 1 30); do
  if redis-cli -h 127.0.0.1 -p "${REDIS_PORT}" ping 2>/dev/null | grep -q PONG; then
    break
  fi
  sleep 1
done

# ── Run Alembic migrations ────────────────────────────────────────────────
cd /app/backend
export PYTHONPATH=/app/backend

echo "[backend] running database migrations …"
/opt/venv/bin/alembic upgrade head 2>&1 || {
  echo "[backend] WARNING: migrations failed – the app may still start"
}

# ── Start FastAPI ─────────────────────────────────────────────────────────
echo "[backend] starting uvicorn on port ${BACKEND_PORT} …"
exec /opt/venv/bin/uvicorn app.main:app \
  --host 0.0.0.0 \
  --port "${BACKEND_PORT}" \
  --no-access-log
